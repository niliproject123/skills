{
  "app": {
    "address": "http://localhost:5173",
    "healthCheck": "http://localhost:3000/health",
    "startCommand": "npm run dev",
    "otherAddresses": ["http://localhost:3000"]
  },
  "signIn": {
    "method": "form",
    "page": "/login",
    "usernameField": "input[name=\"email\"]",
    "passwordField": "input[name=\"password\"]",
    "submit": "button[type=\"submit\"]",
    "signedInWhen": "[data-testid=\"user-menu\"]"
  },
  "people": [
    { "name": "Dana", "username": "dana@example.com", "passwordVariable": "DANA_PASSWORD" },
    { "name": "Omer", "username": "omer@example.com", "passwordVariable": "OMER_PASSWORD" }
  ],
  "seed": { "command": "node guide-videos/seed.mjs --run {runId}" },
  "locators": { "testIdAttribute": "data-testid" },
  "folders": { "scenarios": "guide-videos", "tools": "guide-videos/tools", "output": "guide-videos/output" },
  "captions": { "language": "en", "direction": "ltr" },
  "videoShape": "per-person",
  "branding": { "logo": null, "font": null, "colours": {} },
  "masking": { "fields": [], "patterns": ["email", "phone"] },
  "viewport": { "width": 1440, "height": 900 }
}
