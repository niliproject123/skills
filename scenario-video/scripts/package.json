{
  "name": "scenario-video-tools",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Guide videos cut from a Playwright scenario run: recorder, overlay, cutter, scenario runtime.",
  "license": "MIT",
  "scripts": {
    "video": "tsx src/make.ts",
    "self-check": "tsx src/self-check.ts",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "check-templates": "node check-templates.mjs"
  },
  "dependencies": {
    "@playwright/test": "1.62.1",
    "ffmpeg-static": "5.3.0",
    "playwright": "1.62.1",
    "tsx": "4.23.13"
  },
  "devDependencies": {
    "@types/node": "^20.19.0",
    "typescript": "5.9.3"
  }
}
